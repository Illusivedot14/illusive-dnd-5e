{{#if showPanel}}
<div
  class="illusive-dnd-mock-bar{{#unless inCombat}} illusive-dnd-mock-ooc{{/unless}}{{#if member.isDefeated}} illusive-dnd-mock-defeated{{/if}}{{#if member.isDeathSaving}} illusive-dnd-mock-down{{/if}}{{#if member.isStabilized}} illusive-dnd-mock-stabilized{{/if}}{{#if showYourTurn}} illusive-dnd-mock-your-turn{{/if}}"
  data-actor-id="{{member.actorId}}"
>
  {{#if reactionBanner}}
  <div class="illusive-dnd-reaction-banner illusive-dnd-mock-reaction-banner">
    <span>{{reactionBanner}}</span>
    {{#if showReactionPass}}
    <button type="button" class="illusive-dnd-reaction-pass-btn">{{labels.reactionPass}}</button>
    {{/if}}
  </div>
  {{/if}}

  <div class="illusive-dnd-mock-row">
    <section class="illusive-dnd-mock-left" aria-label="{{labels.vitals}}">
      <div class="illusive-dnd-mock-vitals">
        <div class="illusive-dnd-mock-side illusive-dnd-mock-side-left">
          {{#if configureDisabled}}
          <span class="illusive-dnd-mock-config-btn is-spacer" aria-hidden="true"></span>
          {{else}}
          <button
            type="button"
            class="illusive-dnd-mock-util-btn illusive-dnd-mock-config-btn"
            data-util="configure"
            data-illusive-dnd-tip-title="{{tips.configure.title}}"
            data-illusive-dnd-tip-detail="{{tips.configure.detail}}"
            aria-label="{{labels.configure}}"
          >
            <i class="fas fa-gear" aria-hidden="true"></i>
          </button>
          {{/if}}
          <div class="illusive-dnd-mock-passives" role="group" aria-label="{{labels.passiveScores}}">
            {{#each passives}}
            <span class="illusive-dnd-mock-passive illusive-dnd-mock-passive-{{id}}" data-passive="{{id}}" data-illusive-dnd-tip-title="{{tipTitle}}" data-illusive-dnd-tip-detail="{{tipDetail}}" aria-label="{{tipTitle}}">
              <span class="illusive-dnd-mock-passive-glyph" aria-hidden="true">
                <i class="fas {{icon}}"></i>
              </span>
              <span class="illusive-dnd-mock-passive-value">{{value}}</span>
            </span>
            {{/each}}
            <span class="illusive-dnd-mock-passive illusive-dnd-mock-passive-lang" data-illusive-dnd-tip-title="{{tips.languages.title}}" data-illusive-dnd-tip-detail="{{tips.languages.detail}}" aria-label="{{tips.languages.title}}">
              <span class="illusive-dnd-mock-passive-glyph" aria-hidden="true">
                <i class="fas fa-comment"></i>
              </span>
              <span class="illusive-dnd-mock-passive-value">{{languageCount}}</span>
            </span>
          </div>
        </div>

        <div class="illusive-dnd-mock-portrait-column">
          <div class="illusive-dnd-mock-economy" role="toolbar" aria-label="{{labels.actionEconomy}}">
            {{#if showItemsGem}}
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-items{{#if economy.itemsSpent}} is-spent{{/if}}{{#if economySelected.standard}} is-selected{{/if}}" data-economy="standard" data-illusive-dnd-tip-title="{{tips.gemItems.title}}" data-illusive-dnd-tip-detail="{{tips.gemItems.detail}}" aria-label="{{labels.items}}" aria-pressed="{{economySelected.standard}}">
              <i class="fas fa-suitcase" aria-hidden="true"></i>
            </button>
            {{/if}}
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-action{{#if economy.actionSpent}} is-spent{{/if}}{{#if economySelected.action}} is-selected{{/if}}" data-economy="action" data-illusive-dnd-tip-title="{{tips.gemAction.title}}" data-illusive-dnd-tip-detail="{{tips.gemAction.detail}}" aria-label="{{labels.action}}" aria-pressed="{{economySelected.action}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#d9534f" stroke="#f4a8a6" stroke-width="1.25" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-bonus{{#if economy.bonusSpent}} is-spent{{/if}}{{#if economySelected.bonus}} is-selected{{/if}}" data-economy="bonus" data-illusive-dnd-tip-title="{{tips.gemBonus.title}}" data-illusive-dnd-tip-detail="{{tips.gemBonus.detail}}" aria-label="{{labels.bonus}}" aria-pressed="{{economySelected.bonus}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#5b8fd9" stroke="#9ec5f0" stroke-width="1.25" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-reaction{{#if economy.reactionSpent}} is-spent{{/if}}{{#if economySelected.reaction}} is-selected{{/if}}{{#if reactionGemPrompt}} illusive-dnd-reaction-prompt{{/if}}" data-economy="reaction" data-illusive-dnd-tip-title="{{tips.gemReaction.title}}" data-illusive-dnd-tip-detail="{{tips.gemReaction.detail}}" aria-label="{{labels.reaction}}" aria-pressed="{{economySelected.reaction}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#e0b040" stroke="#f0d878" stroke-width="1.25" stroke-linejoin="round"/></svg>
            </button>
            {{#if showLegendaryGem}}
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-legendary{{#unless legendary.remaining}} is-spent{{/unless}}{{#if economySelected.legendary}} is-selected{{/if}}" data-economy="legendary" data-illusive-dnd-tip-title="{{tips.gemLegendary.title}}" data-illusive-dnd-tip-detail="{{tips.gemLegendary.detail}}" aria-label="{{labels.legendary}}" aria-pressed="{{economySelected.legendary}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#c8a030" stroke="#f0ddb0" stroke-width="1.25" stroke-linejoin="round"/></svg>
              {{#if legendary.remaining}}
              <span class="illusive-dnd-mock-gem-count">{{legendary.remaining}}</span>
              {{/if}}
            </button>
            {{/if}}
            {{#if showLairGem}}
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-lair{{#unless lair.remaining}} is-spent{{/unless}}{{#if economySelected.lair}} is-selected{{/if}}" data-economy="lair" data-illusive-dnd-tip-title="{{tips.gemLair.title}}" data-illusive-dnd-tip-detail="{{tips.gemLair.detail}}" aria-label="{{labels.lair}}" aria-pressed="{{economySelected.lair}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#6a8f5a" stroke="#b0d0a0" stroke-width="1.25" stroke-linejoin="round"/></svg>
              {{#if lair.remaining}}
              <span class="illusive-dnd-mock-gem-count">{{lair.remaining}}</span>
              {{/if}}
            </button>
            {{/if}}
            {{#if showResistanceGem}}
            <button type="button" class="illusive-dnd-mock-gem illusive-dnd-mock-gem-resistance{{#unless resistance.remaining}} is-spent{{/unless}}" data-action="legendary-resistance" data-illusive-dnd-tip-title="{{tips.gemResistance.title}}" data-illusive-dnd-tip-detail="{{tips.gemResistance.detail}}" aria-label="{{labels.legendaryResistance}}">
              <svg class="illusive-dnd-mock-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-mock-gem-face" points="10,1.5 18.5,10 10,18.5 1.5,10" fill="#e8c878" stroke="#fff3c8" stroke-width="1.25" stroke-linejoin="round"/></svg>
              {{#if resistance.remaining}}
              <span class="illusive-dnd-mock-gem-count">{{resistance.remaining}}</span>
              {{/if}}
            </button>
            {{/if}}
          </div>

          <div class="illusive-dnd-full-portrait-block illusive-dnd-mock-portrait-block" data-action="show-location" title="{{labels.showLocation}}">
            {{#unless member.isDowned}}
            <svg class="illusive-dnd-full-rings" viewBox="0 0 {{rings.size}} {{rings.size}}" aria-hidden="true">
              <circle class="illusive-dnd-full-ring-bg" cx="{{rings.center}}" cy="{{rings.center}}" r="{{rings.r}}" fill="none"></circle>
              <circle
                class="illusive-dnd-full-ring-hp illusive-dnd-hp-tier-{{member.hp.tier}}{{#unless colorHpBar}} illusive-dnd-hp-flat{{/unless}}"
                cx="{{rings.center}}"
                cy="{{rings.center}}"
                r="{{rings.r}}"
                fill="none"
                stroke-dasharray="{{rings.hpLength}} {{rings.hpGap}}"
                stroke-dashoffset="0"
                transform="rotate(90 {{rings.center}} {{rings.center}})"
              ></circle>
              {{#if rings.showTemp}}
              <circle
                class="illusive-dnd-full-ring-temp"
                cx="{{rings.center}}"
                cy="{{rings.center}}"
                r="{{rings.r}}"
                fill="none"
                stroke-dasharray="{{rings.tempLength}} {{rings.tempGap}}"
                stroke-dashoffset="{{rings.tempOffset}}"
                transform="rotate(90 {{rings.center}} {{rings.center}})"
              ></circle>
              {{/if}}
            </svg>
            {{/unless}}

            {{#if member.deathSavePips}}
            <svg class="illusive-dnd-mock-ds-ring" viewBox="0 0 {{rings.size}} {{rings.size}}" aria-label="{{deathSavesLabel}}">
              {{#each member.deathSavePips.successes}}
              <circle
                class="illusive-dnd-mock-ds-pip is-success{{#if filled}} is-filled{{/if}}"
                cx="{{cx}}"
                cy="{{cy}}"
                r="7"
                data-action="death-save-pip"
                data-pip-type="success"
                data-pip-index="{{index}}"
                role="button"
                tabindex="-1"
              ></circle>
              {{/each}}
              {{#each member.deathSavePips.failures}}
              <circle
                class="illusive-dnd-mock-ds-pip is-failure{{#if filled}} is-filled{{/if}}"
                cx="{{cx}}"
                cy="{{cy}}"
                r="7"
                data-action="death-save-pip"
                data-pip-type="failure"
                data-pip-index="{{index}}"
                role="button"
                tabindex="-1"
              ></circle>
              {{/each}}
            </svg>
            {{/if}}

            <img class="illusive-dnd-full-portrait illusive-dnd-ornate-portrait illusive-dnd-mock-portrait" src="{{member.img}}" alt="{{member.name}}">

            {{#if member.vitalityIcon}}
            <div class="illusive-dnd-mock-death-overlay{{#if member.isDefeated}} is-dead{{/if}}{{#if member.isStabilized}} is-stabilized{{/if}}" aria-hidden="true">
              <i class="fas {{member.vitalityIcon.icon}}"></i>
            </div>
            {{/if}}

            {{#if member.canRollDeathSave}}
            <button
              type="button"
              class="illusive-dnd-mock-death-save-btn"
              data-action="death-save"
              data-illusive-dnd-tip-title="{{deathSavesLabel}}"
              data-illusive-dnd-tip-detail="{{tips.deathSave.detail}}"
              aria-label="{{tips.deathSave.detail}}"
            ></button>
            {{/if}}

            {{#unless member.isDowned}}
            <div class="illusive-dnd-full-hp-label illusive-dnd-mock-hp-label" data-illusive-dnd-tip-title="{{tips.hp.title}}" data-illusive-dnd-tip-detail="{{tips.hp.detail}}">
              <span class="illusive-dnd-mock-hp-current">{{member.hp.value}}</span>{{#if member.hp.temp}}<span class="illusive-dnd-mock-hp-temp">+{{member.hp.temp}}</span>{{/if}}<span class="illusive-dnd-mock-hp-max">/{{member.hp.max}}</span>
            </div>
            {{/unless}}

            {{#if showStatChips}}
            {{#if member.stats.ac}}
            <span class="illusive-dnd-mock-util-stat illusive-dnd-mock-ac" data-illusive-dnd-tip-title="{{tips.ac.title}}" data-illusive-dnd-tip-detail="{{tips.ac.detail}}">{{member.stats.ac}}</span>
            {{/if}}
            {{/if}}
          </div>
          <div class="illusive-dnd-mock-char-name" title="{{member.name}}">{{member.name}}</div>
        </div>

        <div class="illusive-dnd-mock-util illusive-dnd-mock-util-right" role="toolbar" aria-label="{{labels.utilities}}">
          <button type="button" class="illusive-dnd-mock-util-btn" data-util="sheet" data-illusive-dnd-tip-title="{{tips.sheet.title}}" data-illusive-dnd-tip-detail="{{tips.sheet.detail}}" aria-label="{{labels.openSheet}}">
            <i class="fas fa-file-lines" aria-hidden="true"></i>
          </button>
          <button type="button" class="illusive-dnd-mock-util-btn" data-util="rolls" data-illusive-dnd-tip-title="{{tips.rolls.title}}" data-illusive-dnd-tip-detail="{{tips.rolls.detail}}" aria-label="{{labels.rolls}}">
            <i class="fas fa-dice-d20" aria-hidden="true"></i>
          </button>
          <button type="button" class="illusive-dnd-mock-util-btn{{#if lightOn}} is-active{{/if}}" data-util="light" data-illusive-dnd-tip-title="{{tips.light.title}}" data-illusive-dnd-tip-detail="{{tips.light.detail}}" aria-label="{{labels.toggleLight}}" aria-pressed="{{lightOn}}">
            <i class="fas fa-lightbulb" aria-hidden="true"></i>
          </button>
          {{#unless visibilityDisabled}}
          <button type="button" class="illusive-dnd-mock-util-btn" data-util="visibility" data-illusive-dnd-tip-title="{{tips.visibility.title}}" data-illusive-dnd-tip-detail="{{tips.visibility.detail}}" aria-label="{{labels.toggleVisibility}}">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
          {{/unless}}
        </div>
      </div>
    </section>

    <section class="illusive-dnd-mock-center{{#if targetPick}} is-target-pick{{/if}}" aria-label="{{labels.actionEconomy}}">
      <div class="illusive-dnd-mock-center-body">
        {{#if targetPick}}
        <div class="illusive-dnd-mock-target-pick" role="status">
          <div class="illusive-dnd-mock-target-pick-title">{{targetPick.abilityName}}</div>
          <div class="illusive-dnd-mock-target-pick-count">{{targetPick.label}}</div>
          <p class="illusive-dnd-mock-target-pick-hint">{{labels.targetPickCanvasHint}}</p>
          <button
            type="button"
            class="illusive-dnd-mock-target-cancel"
            data-action="target-pick-cancel"
            aria-label="{{targetPick.cancelLabel}}"
            data-illusive-dnd-tip-title="{{targetPick.cancelLabel}}"
            data-illusive-dnd-tip-detail="Esc"
          >
            <i class="fas fa-xmark" aria-hidden="true"></i>
            <span>{{targetPick.cancelLabel}}</span>
            <kbd class="illusive-dnd-mock-target-cancel-key">Esc</kbd>
          </button>
        </div>
        {{else}}
        {{#if resources.length}}
        <div class="illusive-dnd-mock-resources" role="group" aria-label="{{labels.resources}}">
          {{#each resources}}
          <div
            class="illusive-dnd-mock-resource is-{{kind}}"
            data-resource="{{id}}"
            data-illusive-dnd-tip-title="{{label}}"
            data-illusive-dnd-tip-detail="{{tipDetail}}"
            aria-label="{{label}}: {{value}} / {{max}}{{#if subtitle}} ({{subtitle}}){{/if}}"
          >
            <span class="illusive-dnd-mock-resource-label">{{label}}</span>
            {{#if diamonds}}
            <span class="illusive-dnd-spell-slot-diamonds" aria-hidden="true">
              {{#each diamonds}}
              <span class="illusive-dnd-spell-slot-gem{{#unless filled}} is-spent{{/unless}}">
                <svg class="illusive-dnd-spell-slot-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="illusive-dnd-spell-slot-gem-outer" points="10,1 19,10 10,19 1,10"/><polygon class="illusive-dnd-spell-slot-gem-inner" points="10,6 14,10 10,14 6,10"/></svg>
              </span>
              {{/each}}
            </span>
            {{else}}
            <span class="illusive-dnd-mock-resource-count">{{value}}/{{max}}</span>
            {{/if}}
            {{#if subtitle}}
            <span class="illusive-dnd-mock-resource-sub">{{subtitle}}</span>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        <div class="illusive-dnd-mock-ability-well" role="region" aria-label="{{sectionTitle}}">
          {{{abilitiesHtml}}}
        </div>
        {{/if}}
      </div>
    </section>

    <section class="illusive-dnd-mock-right">
      <div class="illusive-dnd-mock-right-cluster">
        <div class="illusive-dnd-mock-combat-rail illusive-dnd-mock-combat-rail-left" role="toolbar" aria-label="{{labels.flipToken}}">
          {{#if movement}}
          <button
            type="button"
            class="illusive-dnd-mock-move-btn"
            data-util="movement"
            data-illusive-dnd-tip-title="{{tips.movement.title}}"
            data-illusive-dnd-tip-detail="{{tips.movement.detail}}"
            aria-label="{{#if movement.modeLabel}}{{movement.modeLabel}}{{else}}{{tips.movement.title}}{{/if}}"
          >
            <i class="fas {{#if movement.modeIcon}}{{movement.modeIcon}}{{else}}fa-person-walking{{/if}}" aria-hidden="true"></i>
          </button>
          {{/if}}
          <button
            type="button"
            class="illusive-dnd-mock-flip-btn{{#if tokenFlipped}} is-active{{/if}}"
            data-util="flip"
            data-illusive-dnd-tip-title="{{tips.flip.title}}"
            data-illusive-dnd-tip-detail="{{tips.flip.detail}}"
            aria-label="{{labels.flipToken}}"
            aria-pressed="{{tokenFlipped}}"
          >
            <i class="fas fa-left-right" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="illusive-dnd-mock-aura-btn{{#if auraOn}} is-active{{/if}}"
            data-util="aura"
            data-illusive-dnd-tip-title="{{tips.aura.title}}"
            data-illusive-dnd-tip-detail="{{tips.aura.detail}}"
            aria-label="{{labels.toggleAura}}"
            aria-pressed="{{auraOn}}"
          >
            <i class="fas fa-circle" aria-hidden="true"></i>
          </button>
        </div>

        <div class="illusive-dnd-mock-combat-column">
          <div class="illusive-dnd-mock-elevation" role="group" aria-label="{{labels.elevation}}">
            <button
              type="button"
              class="illusive-dnd-mock-elevation-btn"
              data-action="elevation-down"
              data-illusive-dnd-tip-title="{{labels.elevationDown}}"
              data-illusive-dnd-tip-detail="{{tips.elevation.detail}}"
              aria-label="{{labels.elevationDown}}"
            >
              <i class="fas fa-caret-down" aria-hidden="true"></i>
            </button>
            <span class="illusive-dnd-mock-elevation-value" data-illusive-dnd-tip-title="{{tips.elevation.title}}" data-illusive-dnd-tip-detail="{{tips.elevation.detail}}">{{elevation}}</span>
            <button
              type="button"
              class="illusive-dnd-mock-elevation-btn"
              data-action="elevation-up"
              data-illusive-dnd-tip-title="{{labels.elevationUp}}"
              data-illusive-dnd-tip-detail="{{tips.elevation.detail}}"
              aria-label="{{labels.elevationUp}}"
            >
              <i class="fas fa-caret-up" aria-hidden="true"></i>
            </button>
          </div>
          <div class="illusive-dnd-mock-combat-block">
            {{#if targetPick}}
            <button
              type="button"
              class="illusive-dnd-mock-combat-btn illusive-dnd-mock-confirm-btn{{#unless targetPick.canConfirm}} is-disabled{{/unless}}"
              data-action="target-pick-confirm"
              data-illusive-dnd-tip-title="{{targetPick.confirmLabel}}"
              data-illusive-dnd-tip-detail="{{targetPick.label}}"
              aria-label="{{targetPick.confirmLabel}}"
              {{#unless targetPick.canConfirm}}disabled{{/unless}}
            >
              <i class="fas fa-check" aria-hidden="true"></i>
            </button>
            {{else}}
            {{#if movement}}
            {{#if speedRing}}
            <svg class="illusive-dnd-mock-speed-ring" viewBox="0 0 {{speedRing.size}} {{speedRing.size}}" aria-hidden="true">
              <circle class="illusive-dnd-mock-speed-ring-bg" cx="{{speedRing.center}}" cy="{{speedRing.center}}" r="{{speedRing.r}}" fill="none"></circle>
              <circle
                class="illusive-dnd-mock-speed-ring-fill{{#if speedRing.isDashing}} is-dashing{{/if}}"
                cx="{{speedRing.center}}"
                cy="{{speedRing.center}}"
                r="{{speedRing.r}}"
                fill="none"
                stroke-dasharray="{{speedRing.displayFillLength}} {{speedRing.displayFillGap}}"
                stroke-dashoffset="0"
                transform="rotate(90 {{speedRing.center}} {{speedRing.center}})"
              ></circle>
            </svg>
            {{/if}}
            {{/if}}

            <button
              type="button"
              class="illusive-dnd-mock-combat-btn is-{{combatButton.tone}}{{#if combatButton.disabled}} is-disabled{{/if}}{{#if combatButton.waiting}} is-waiting{{/if}}"
              data-action="combat-flow"
              data-illusive-dnd-tip-title="{{tips.combat.title}}"
              data-illusive-dnd-tip-detail="{{tips.combat.detail}}"
              aria-label="{{combatButton.label}}"
              aria-disabled="{{#if combatButton.disabled}}true{{else}}false{{/if}}"
            >
              <i class="fas {{combatButton.icon}}" aria-hidden="true"></i>
            </button>

            {{#if movement}}
            <div class="illusive-dnd-mock-speed-readout is-static" aria-label="{{tips.movement.title}}">
              <span class="illusive-dnd-mock-speed-feet">{{movement.remainingFeet}}{{#if inCombat}}/{{movement.maxFeet}}{{/if}}<span class="illusive-dnd-mock-speed-unit"> {{feetUnit}}</span></span>
            </div>
            {{/if}}
            {{/if}}
          </div>
        </div>

        <div class="illusive-dnd-mock-combat-rail illusive-dnd-mock-combat-rail-right" role="toolbar" aria-label="{{labels.utilities}}">
          <button
            type="button"
            class="illusive-dnd-mock-status-btn"
            data-util="status"
            data-illusive-dnd-tip-title="{{tips.status.title}}"
            data-illusive-dnd-tip-detail="{{tips.status.detail}}"
            aria-label="{{labels.assignStatus}}"
          >
            <i class="fas fa-tags" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="illusive-dnd-mock-game-log-btn{{#unless gameLog.enabled}} is-disabled{{/unless}}{{#if gameLog.canUndo}} has-entries{{/if}}"
            data-util="game-log"
            data-illusive-dnd-tip-title="{{tips.gameLog.title}}"
            data-illusive-dnd-tip-detail="{{tips.gameLog.detail}}"
            aria-label="{{labels.gameLog}}"
            {{#unless gameLog.enabled}}disabled aria-disabled="true"{{/unless}}
          >
            <i class="fas fa-scroll" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="illusive-dnd-mock-util-btn illusive-dnd-mock-rest-btn{{#if showLeaveCombat}} is-leave{{/if}}{{#if restDisabled}} is-disabled{{/if}}"
            data-util="rest"
            data-illusive-dnd-tip-title="{{tips.rest.title}}"
            data-illusive-dnd-tip-detail="{{tips.rest.detail}}"
            aria-label="{{utilityRestLabel}}"
            {{#if restDisabled}}disabled{{/if}}
          >
            <i class="fas {{#if showLeaveCombat}}fa-right-from-bracket{{else}}fa-bed{{/if}}" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </section>
  </div>
</div>
{{/if}}
